# Copia este archivo a `.env` y rellena los dos valores con los de tu
# proyecto de Supabase (Project Settings → API). `.env` está en .gitignore.
#
# Ambas variables llevan el prefijo EXPO_PUBLIC_ porque Expo las inlinea en
# el bundle: solo pueden contener valores públicos. La clave anon/publishable
# lo es por diseño — quien protege los datos es RLS, no el secreto de la clave.
# La `service_role` NUNCA debe aparecer aquí.

# OJO: la URL es solo el origen, sin ruta ni barra final. Si pegas aquí el
# endpoint REST (.../rest/v1), el alta de usuarios acaba en PostgREST y
# responde "PGRST125 - Invalid path specified in request URL".
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
